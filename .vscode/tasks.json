{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lint Python Files",
            "type": "shell",
            "command": "${workspaceFolder}/backend/dev/Scripts/python.exe -m ruff check . --fix ",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": []
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Type Check Python Files",
            "type": "shell",
            "command": "${workspaceFolder}/backend/dev/Scripts/python.exe -m mypy backend",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": []
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Format Python Files",
            "type": "shell",
            "command": "${workspaceFolder}/backend/dev/Scripts/python.exe -m ruff format .",
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "shell": {
                    "executable": "powershell.exe",
                    "args": []
                }
            },
            "problemMatcher": []
        }
    ]
}
