{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format Backend",
            "type": "shell",
            "command": "${workspaceFolder}/backend/dev/Scripts/python.exe -m ruff format .",
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "shell": {
                    "executable": "powershell.exe",
                    "args": []
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Format Frontend",
            "type": "shell",
            "command": "npm run-script format",
            "group": {
                "kind": "build"
            },
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "shell": {
                    "executable": "powershell.exe",
                    "args": []
                }
            },
            "detail": "Format Frontend code using Prettier"
        },
        {
            "label": "Lint Backend",
            "type": "shell",
            "command": "${workspaceFolder}/backend/dev/Scripts/python.exe -m ruff check . --fix ",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": []
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Lint Frontend",
            "type": "shell",
            "command": "npm run-script lint",
            "group": {
                "kind": "build"
            },
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "shell": {
                    "executable": "powershell.exe",
                    "args": []
                }
            },
            "detail": "Lint *.ts and *.tsx files"
        },
        {
            "label": "Typecheck Backend",
            "type": "shell",
            "command": "${workspaceFolder}/backend/dev/Scripts/python.exe -m mypy backend --config-file ${workspaceFolder}/backend/pyproject.toml",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": []
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Typecheck Frontend",
            "type": "shell",
            "command": "npm run typecheck",
            "group": {
                "kind": "build"
            },
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "shell": {
                    "executable": "powershell.exe",
                    "args": []
                }
            },
            "detail": "Typecheck *.ts and *.tsx files"
        }
    ]
}
