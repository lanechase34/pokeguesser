{
    "name": "pokeguesser",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "vite",
        "build": "tsc -b && vite build",
        "serve": "vite preview",
        "test": "jest",
        "testcoverage": "jest --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "audit:prod": "npm audit --omit=dev",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "format:check": "prettier --config .prettierrc --check \"**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit"
    },
