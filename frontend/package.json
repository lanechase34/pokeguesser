        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "globals": "^17.5.0",
        "jest": "^30.3.0",
        "jest-environment-jsdom": "^30.3.0",
        "jiti": "^2.6.1",
        "npm-check-updates": "21.0.2",
        "prettier": "^3.8.3",
